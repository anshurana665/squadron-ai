# ── Environment & Secrets (Never commit secrets) ──
.env
.env.local
.env.*.local
.env.development
.env.production
*.env

# ── Python Cache & Bytecode ──
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ── Virtual Environments ──
venv/
.venv/
env/
.env_local/

# ── Packaging & Distribution ──
dist/
build/
*.egg-info/
*.egg

# ── Testing & Code Quality ──
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# ── Runtime Scratch & Generated PoCs ──
tests/pocs/*.py
!tests/pocs/.gitkeep
workspace/
tmp/
temp/
uploads/

# ── Benchmarking & Paper Artifacts ──
benchmarks/plots/
benchmarks/data/*.json
benchmarks/data/*.jsonl
!benchmarks/data/.gitkeep
paper_plots/
*.jsonl

# ── Logs & Databases ──
*.log
logs/
*.sqlite
*.sqlite3
*.db

# ── IDE & Operating System ──
.vscode/
.idea/
*.swp
*.swo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db