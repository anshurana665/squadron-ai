# ─────────────────────────────────────────────────────────
# .env.example
# Instructions: Copy this file to .env and fill in the values.
# NEVER COMMIT THE REAL .env FILE TO VERSION CONTROL!
# ─────────────────────────────────────────────────────────

# ── LLM Providers ──
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Model Routing Overrides (Optional) ──
# REASONING_MODEL=moonshotai/kimi-k3
# CODING_MODEL=moonshotai/kimi-k3
# REVIEWER_MODEL=moonshotai/kimi-k3

# ── E2B Sandbox for Reviewer Verification ──
E2B_API_KEY=your_e2b_api_key_here

# ── Demo / Infrastructure Configuration ──
DB_HOST=prod-db.internal.company.com
DB_USER=root
DB_PASSWORD=your_db_password_here

SMTP_HOST=smtp.gmail.com
SMTP_USER=devops@company.com
SMTP_PASS=your_smtp_app_password_here

AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
